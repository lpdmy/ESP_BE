@startuml Add Members in Class
actor Admin
participant ": ClassDetailPage " as ClassDetailPage
participant ": Router " as Router
participant ": ClassGroupController " as ClassGroupController
participant ": ClassGroupService " as ClassGroupService
participant ": ClassGroupRepository " as ClassGroupRepository
database Database

Admin->ClassDetailPage: 1. Click "Thêm học sinh" button
    activate Admin
    activate ClassDetailPage

Admin->ClassDetailPage: 2. Enter student email in modal

Admin->ClassDetailPage: 3. Click "Thêm" button

ClassDetailPage->Router: 4. Send POST /api/classgroup/{id}/students with email
    activate Router
    deactivate ClassDetailPage

Router->ClassGroupController: 5. Route Request to Controller
    activate ClassGroupController
    deactivate Router

ClassGroupController->ClassGroupService: 6. AddStudentToClassAsync(classGroupId, dto)
    activate ClassGroupService
    deactivate ClassGroupController

ClassGroupService->ClassGroupRepository: 7. GetStudentByEmailAsync(email)
    activate ClassGroupRepository
    ClassGroupRepository->Database: 8. Query User by Email
    activate Database
    Database-->ClassGroupRepository: 9. Return User or null
    deactivate Database
    ClassGroupRepository-->ClassGroupService: 10. Return Student entity
    deactivate ClassGroupRepository

    alt student not found
        ClassGroupService-->ClassGroupController: 11.1 Return error (Student not found)
        activate ClassGroupController
        ClassGroupController-->Router: 11.1.1 Send Error Response (400)
        activate Router
        deactivate ClassGroupController
        Router-->ClassDetailPage: 11.1.2 Return error message
        activate ClassDetailPage
        deactivate Router
        ClassDetailPage->ClassDetailPage: 11.1.3 Display error message
        ClassDetailPage-->Admin: 11.1.4 Show error toast
        deactivate ClassDetailPage
        deactivate Admin

    else student found
        ClassGroupService->ClassGroupRepository: 11.2 IsStudentInClassAsync(classGroupId, studentId)
        activate ClassGroupRepository
        ClassGroupRepository->Database: 11.2.1 Check ClassGroupMembers table
        activate Database
        Database-->ClassGroupRepository: 11.2.2 Return true/false
        deactivate Database
        ClassGroupRepository-->ClassGroupService: 11.2.3 Return isInClass result
        deactivate ClassGroupRepository

        alt student already in class
            ClassGroupService-->ClassGroupController: 11.2.4 Return error (Already in class)
            activate ClassGroupController
            ClassGroupController-->Router: 11.2.4.1 Send Error Response (400)
            activate Router
            deactivate ClassGroupController
            Router-->ClassDetailPage: 11.2.4.2 Return error message
            activate ClassDetailPage
            deactivate Router
            ClassDetailPage->ClassDetailPage: 11.2.4.3 Display error message
            ClassDetailPage-->Admin: 11.2.4.4 Show error toast
            deactivate ClassDetailPage
            deactivate Admin

        else student not in class
            ClassGroupService->ClassGroupRepository: 11.2.5 GetStudentCurrentClassInSameAcademicYearAsync(studentId, academicYearId)
            activate ClassGroupRepository
            ClassGroupRepository->Database: 11.2.5.1 Query student's class in same academic year
            activate Database
            Database-->ClassGroupRepository: 11.2.5.2 Return ClassGroup or null
            deactivate Database
            ClassGroupRepository-->ClassGroupService: 11.2.5.3 Return current class
            deactivate ClassGroupRepository

            alt student has another class in same academic year
                ClassGroupService-->ClassGroupController: 11.2.5.4 Return error (Has another class)
                activate ClassGroupController
                ClassGroupController-->Router: 11.2.5.4.1 Send Error Response
                activate Router
                deactivate ClassGroupController
                Router-->ClassDetailPage: 11.2.5.4.2 Return error with current class info
                activate ClassDetailPage
                deactivate Router
                ClassDetailPage->ClassDetailPage: 11.2.5.4.3 Display error message
                ClassDetailPage-->Admin: 11.2.5.4.4 Show error toast
                deactivate ClassDetailPage
                deactivate Admin

            else student can be added
                ClassGroupService->ClassGroupRepository: 11.2.5.5 AddStudentToClassAsync(classGroupId, studentId)
                activate ClassGroupRepository
                ClassGroupRepository->Database: 11.2.5.5.1 INSERT into ClassGroupMembers
                activate Database
                Database-->ClassGroupRepository: 11.2.5.5.2 Return success
                deactivate Database
                ClassGroupRepository-->ClassGroupService: 11.2.5.5.3 Return true
                deactivate ClassGroupRepository

                ClassGroupService->ClassGroupService: 11.2.5.5.4 Create AddStudentToClassResponseDto
                ClassGroupService-->ClassGroupController: 11.2.5.5.5 Return success response
                activate ClassGroupController
                deactivate ClassGroupService

                ClassGroupController->ClassGroupController: 11.2.5.5.6 Wrap in ResponseDto
                ClassGroupController-->Router: 11.2.5.5.7 Send Success Response
                activate Router
                deactivate ClassGroupController
                Router-->ClassDetailPage: 11.2.5.5.8 Return success message
                activate ClassDetailPage
                deactivate Router
                ClassDetailPage->ClassDetailPage: 11.2.5.5.9 Close modal and show success toast
                ClassDetailPage-->Admin: 11.2.5.5.10 Display success message
                deactivate ClassDetailPage
                deactivate Admin
            end
        end
    end
@enduml
