@startuml Update Staff Account by Admin
actor Admin
participant ": StaffManagementPage " as StaffManagementPage
participant ": Router " as Router
participant ": StaffController " as StaffController
participant ": StaffService " as StaffService
participant ": UserRepository " as UserRepository
participant ": UserRightRepository " as UserRightRepository
database Database

Admin->StaffManagementPage: 1. Click on a staff to view details
    activate Admin
    activate StaffManagementPage

StaffManagementPage->StaffManagementPage: 2. Open Staff Detail Modal with existing data

Admin->StaffManagementPage: 3. Click "Chỉnh sửa" button

Admin->StaffManagementPage: 4. Update Staff Information (firstName, lastName, phoneNumber, password, permissions)

Admin->StaffManagementPage: 5. Click "Lưu" button

StaffManagementPage->StaffManagementPage: 6. Validate input fields

alt valid input
    StaffManagementPage->Router: 6.1.1 Send PUT /api/staff with UpdateStaffDto
    deactivate StaffManagementPage
    activate Router

    Router->StaffController: 6.1.2 Route Request to Controller
    deactivate Router
    activate StaffController

    StaffController->StaffService: 6.1.3 UpdateStaff(dto)
    deactivate StaffController
    activate StaffService

    StaffService->UserRepository: 6.1.4 GetByStaffIdIncluding(staffId)
    activate UserRepository
    UserRepository->Database: 6.1.5 Query User by Id with UserRights
    activate Database
    Database-->UserRepository: 6.1.6 Return User or null
    deactivate Database
    UserRepository-->StaffService: 6.1.7 Return User entity
    deactivate UserRepository

    alt staff not found
        StaffService->StaffService: 6.2.1 Throw BadRequestException
        StaffService-->StaffController: 6.2.1.1 Return error (Staff not found)
        activate StaffController
        deactivate StaffService
        StaffController-->Router: 6.2.1.2 Send Error Response (400)
        activate Router
        deactivate StaffController
        Router-->StaffManagementPage: 6.2.1.3 Return error message
        activate StaffManagementPage
        deactivate Router
        StaffManagementPage->StaffManagementPage: 6.2.1.4 Display error message
        StaffManagementPage-->Admin: 6.2.1.5 Show error toast
        deactivate StaffManagementPage
        deactivate Admin
    else staff found
        StaffService->StaffService: 6.2.2 Update User fields (FirstName, LastName, Email, PhoneNumber)
        StaffService->StaffService: 6.2.2.1 Hash password if provided

        StaffService->StaffService: 6.2.2.2 Check if permissions changed
        StaffService->UserRightRepository: 6.2.2.3 HasRight(staffId)
        activate UserRightRepository
        UserRightRepository->Database: 6.2.2.4 Query UserRights by UserId
        activate Database
        Database-->UserRightRepository: 6.2.2.5 Return hasRight result
        deactivate Database
        UserRightRepository-->StaffService: 6.2.2.6 Return hasRight
        deactivate UserRightRepository

        alt permissions changed
            StaffService->UserRightRepository: 6.2.2.7 DeleteByUserIdAsync(staffId)
            activate UserRightRepository
            UserRightRepository->Database: 6.2.2.8 DELETE UserRights WHERE UserId = {id}
            activate Database
            Database-->UserRightRepository: 6.2.2.9 UserRights deleted
            deactivate Database
            UserRightRepository-->StaffService: 6.2.2.10 Return
            deactivate UserRightRepository

            StaffService->StaffService: 6.2.2.11 Create new UserRight entities
            StaffService->UserRightRepository: 6.2.2.12 AddRangeAsync(newRights)
            activate UserRightRepository
            UserRightRepository->Database: 6.2.2.13 INSERT into UserRights
            activate Database
            Database-->UserRightRepository: 6.2.2.14 Return created UserRights
            deactivate Database
            UserRightRepository-->StaffService: 6.2.2.15 Return UserRights
            deactivate UserRightRepository
        else permissions not changed
            StaffService->StaffService: 6.2.2.16 Skip permission update
        end

        StaffService->StaffService: 6.2.2.17 Set UpdatedAt = DateTime.UtcNow
        StaffService->UserRepository: 6.2.2.18 UpdateAsync(staff)
        activate UserRepository
        UserRepository->Database: 6.2.2.19 UPDATE User Record
        activate Database
        Database-->UserRepository: 6.2.2.20 User Updated Successfully
        deactivate Database
        UserRepository-->StaffService: 6.2.2.21 User Updated
        deactivate UserRepository

        StaffService->UserRepository: 6.2.2.22 GetByStaffIdIncluding(staffId)
        activate UserRepository
        UserRepository->Database: 6.2.2.23 Query User with UserRights
        activate Database
        Database-->UserRepository: 6.2.2.24 Return User with relations
        deactivate Database
        UserRepository-->StaffService: 6.2.2.25 Return User with UserRights
        deactivate UserRepository

        StaffService->StaffService: 6.2.2.26 Map User to UserResponseDto
        StaffService-->StaffController: 6.2.2.27 Return UserResponseDto
        activate StaffController
        deactivate StaffService

        StaffController-->Router: 6.2.2.28 Send Success Response (200)
        activate Router
        deactivate StaffController

        Router-->StaffManagementPage: 6.2.2.29 Staff Information Updated Successfully
        activate StaffManagementPage
        deactivate Router

        StaffManagementPage->StaffManagementPage: 6.2.2.30 Show Success Message
        StaffManagementPage->StaffManagementPage: 6.2.2.31 Refresh staff list
        StaffManagementPage-->Admin: 6.2.2.32 Show Updated Staff Information
        deactivate StaffManagementPage
        deactivate Admin
    end
else invalid input
    StaffManagementPage->StaffManagementPage: 6.3.1 Show error toast
    StaffManagementPage-->Admin: 6.3.1.1 Display "Vui lòng điền đầy đủ thông tin"
    deactivate StaffManagementPage
    deactivate Admin
end
@enduml





